{
  "name": "asyncapi-preview",
  "displayName": "asyncapi-preview",
  "description": "Preview AsyncAPI documents inside VSCode.",
  "version": "1.1.1",
  "icon": "asyncapi-logo.png",
  "galleryBanner": {
    "color": "#4a4a4a",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "publisher": "asyncapi",
  "author": {
    "name": "Iván García Sainz-Aja",
    "email": "ivangsa@gmail.com",
    "url": "https://github.com/ivangsa"
  },
  "bugs": {
    "url": "https://github.com/asyncapi/vs-asyncapi-preview/issues"
  },
  "homepage": "https://github.com/asyncapi/vs-asyncapi-preview/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/asyncapi/vs-asyncapi-preview.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yml",
    "onLanguage:yaml",
    "onLanguage:json",
    "onCommand:asyncapi.preview",
    "onCommand:asyncapi.visualize",
    "onCommand:asyncapi.focusview"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Previewing remains available. Extension-host reference resolution and secret access require a trusted workspace.",
      "restrictedConfigurations": [
        "asyncapi.remoteRefs.resolve",
        "asyncapi.remoteAuth",
        "asyncapi.loaders",
        "asyncapi.allowedHosts"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "asyncapi.preview",
        "title": "AsyncAPI: Preview",
        "icon": {
          "light": "resources/icons/open-preview_black.svg",
          "dark": "resources/icons/open-preview_white.svg"
        }
      },
      {
        "command": "asyncapi.paste",
        "title": "AsyncAPI: Paste as Schema"
      },
      {
        "command": "asyncapi.focusview",
        "title": "AsyncAPI: Focus View"
      },
      {
        "command": "asyncapi.setSecret",
        "title": "AsyncAPI: Set Secret",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asyncapi.deleteSecret",
        "title": "AsyncAPI: Delete Secret",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "asyncapi.clearRemoteCache",
        "title": "AsyncAPI: Clear Remote Reference Cache"
      }
    ],
    "configuration": {
      "title": "AsyncAPI Preview",
      "properties": {
        "asyncapi.remoteRefs.resolve": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Resolve external $refs in the extension host only when asyncapi.loaders, asyncapi.remoteAuth or asyncapi.allowedHosts is configured. Otherwise the preview loads the document in the webview, as it always did.",
            "Always resolve external $refs in the extension host, even without authentication configured.",
            "Never resolve external $refs in the extension host."
          ],
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "When the extension host resolves external `$ref`s before rendering the preview. Host side resolution is what makes authentication, corporate proxies and non CORS servers work, and it is required for `#asyncapi.remoteAuth#` and `#asyncapi.loaders#`."
        },
        "asyncapi.remoteAuth": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "Default authentication used for any remote $ref that does not match an asyncapi.loaders entry. Only sent to hosts listed in asyncapi.allowedHosts.",
          "properties": {
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Static HTTP headers."
            },
            "bearerToken": {
              "type": "string",
              "markdownDescription": "Not recommended. Token stored in `settings.json` (may be synced or committed). Prefer `#asyncapi.remoteAuth#` `bearerTokenSecret` and **AsyncAPI: Set Secret**."
            },
            "bearerTokenSecret": {
              "type": "string",
              "markdownDescription": "Key of a bearer token stored by **AsyncAPI: Set Secret**. `settings.json` keeps only this name; the token is in the OS keychain."
            },
            "basic": {
              "type": "object",
              "description": "HTTP basic authentication.",
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string",
                  "markdownDescription": "Not recommended. Password stored in `settings.json` (may be synced or committed). Prefer `passwordSecret` and **AsyncAPI: Set Secret**."
                },
                "passwordSecret": {
                  "type": "string",
                  "markdownDescription": "Key of a password stored by **AsyncAPI: Set Secret**. `settings.json` keeps only this name; the password is in the OS keychain."
                }
              }
            }
          }
        },
        "asyncapi.loaders": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Per host authentication for remote $refs. The first entry whose match applies wins.",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string",
                "description": "URL prefix or JavaScript regular expression source matched against the requested reference."
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "bearerToken": {
                "type": "string",
                "markdownDescription": "Not recommended. Token stored in `settings.json`. Prefer `bearerTokenSecret` and **AsyncAPI: Set Secret**."
              },
              "bearerTokenSecret": {
                "type": "string",
                "markdownDescription": "Key of a bearer token stored by **AsyncAPI: Set Secret**."
              },
              "basic": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "markdownDescription": "Not recommended. Password stored in `settings.json`. Prefer `passwordSecret` and **AsyncAPI: Set Secret**."
                  },
                  "passwordSecret": {
                    "type": "string",
                    "markdownDescription": "Key of a password stored by **AsyncAPI: Set Secret**."
                  }
                }
              }
            }
          }
        },
        "asyncapi.allowedHosts": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Hosts allowed to serve remote $refs. When empty every public host can be read; loopback, private and link-local addresses always require the host to be listed here or pinned by an asyncapi.loaders URL prefix. Listing a host here also authorises sending it the configured credentials, which asyncapi.remoteAuth and regular expression loaders require. An entry with a port matches that port only, an entry without one matches any port.",
          "items": {
            "type": "string"
          }
        },
        "asyncapi.outputVerbosity": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "off",
          "scope": "resource",
          "description": "Controls logging verbosity in the AsyncAPI Preview output channel."
        }
      }
    },
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/snippets.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "(resourceLangId == json || resourceLangId == yaml) && asyncapi.isAsyncAPI",
          "command": "asyncapi.preview",
          "group": "navigation"
        },
        {
          "when": "(resourceLangId == json || resourceLangId == yaml) && asyncapi.isAsyncAPI",
          "command": "asyncapi.preview"
        },
        {
          "when": "(resourceLangId == json || resourceLangId == yaml) && asyncapi.isAsyncAPI",
          "command": "asyncapi.visualize"
        }
      ],
      "commandPalette": [
        {
          "command": "asyncapi.preview"
        },
        {
          "command": "asyncapi.visualize"
        }
      ],
      "editor/context": [
        {
          "when": "(resourceLangId == json || resourceLangId == yaml) && asyncapi.isAsyncAPI",
          "command": "asyncapi.paste",
          "group": "9_cutcopypaste@5"
        }
      ],
      "keybindings": [
        {
          "command": "asyncapi.paste",
          "key": "Ctrl+V",
          "linux": "Ctrl+Shift+V",
          "mac": "Cmd+V",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "test": "",
    "test:remote-refs": "node --test tests/remoteRefs.test.cjs tests/secretSettings.test.cjs",
    "generate:assets": "",
    "bump:version": "npm --no-git-tag-version --allow-same-version version $VERSION",
    "open-in-browser": "vscode-test-web --extensionDevelopmentPath=. --port=8082"
  },
  "devDependencies": {
    "@asyncapi/react-component": "3.1.4",
    "@types/glob": "^7.2.0",
    "@types/js-yaml": "^4.0.5",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^5.21.0",
    "@typescript-eslint/parser": "^5.21.0",
    "@vscode/test-electron": "^2.1.3",
    "@vscode/test-web": "^0.0.72",
    "ajv": "^8.11.0",
    "copy-webpack-plugin": "^10.2.4",
    "eslint": "^8.14.0",
    "genson-js": "0.0.8",
    "glob": "^8.0.1",
    "js-yaml": "^4.1.0",
    "mocha": "^9.2.2",
    "ts-loader": "^9.2.8",
    "typescript": "^4.6.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^4.10.0"
  }
}
